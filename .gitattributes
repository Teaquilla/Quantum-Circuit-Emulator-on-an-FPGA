# Normalisasi akhir baris: semua file teks disimpan dengan LF di repo.
# Penting agar `python ref/qsim.py gen` di CI (Linux) menghasilkan file yang identik dengan yang di-commit dari Windows.
* text=auto
*.mem text eol=lf
*.vhd text eol=lf
*.py  text eol=lf
*.sh  text eol=lf
*.yml text eol=lf
*.md  text eol=lf
*.xdc text eol=lf
*.tcl text eol=lf
*.bit binary
